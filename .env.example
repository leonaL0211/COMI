# OriginRouter-compatible chat configuration for non-streaming text chat.
# Keep real keys only in local environment files. Never commit secrets.
# The default max output token value is 8192 when no override is provided.
# Larger values are passed through as positive integers; final limits are enforced by the upstream API.

CLAUDE_API_BASE_URL=https://api.originrouter.com/v1
CLAUDE_API_KEY=your-originrouter-api-key
CLAUDE_MODEL_ID=claude-sonnet-4-6
CLAUDE_MAX_OUTPUT_TOKENS=8192

# Optional aliases supported by Berry Chat v2.
ORIGINROUTER_API_BASE_URL=https://api.originrouter.com/v1
ORIGINROUTER_API_KEY=your-originrouter-api-key
ORIGINROUTER_MODEL_ID=claude-sonnet-4-6
ORIGINROUTER_MAX_OUTPUT_TOKENS=8192

# Server-only Supabase persistence configuration.
# Do not expose these through NEXT_PUBLIC_ variables.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-server-secret-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-fallback
BERRY_OWNER_ID=00000000-0000-4000-8000-000000000000
